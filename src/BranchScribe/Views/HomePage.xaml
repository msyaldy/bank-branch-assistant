<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BranchScribe.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:BranchScribe.ViewModels">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="32,24,32,32">
        <StackPanel Spacing="24"
                    HorizontalAlignment="Stretch">

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.Greeting, Mode=OneWay}"
                           Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{x:Bind ViewModel.TodayDate, Mode=OneWay}"
                           FontSize="14" Foreground="#71717A"
                           FontFamily="Segoe UI Variable, Segoe UI" />
            </StackPanel>

            <!-- Local model hero -->
            <Border Background="#F3F8FD" BorderBrush="#C9DFF2" BorderThickness="1"
                    CornerRadius="8" Padding="14">
                <Grid ColumnSpacing="20" VerticalAlignment="Center"
                      MinHeight="96">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="5" VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                        <TextBlock Text="Your AI, running locally"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="#083B66" />
                        <TextBlock Text="BranchScribe uses Foundry Local and the QNN execution provider to keep sensitive customer conversations on this device."
                                   FontSize="12" Foreground="#315A7D"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                            <Border Background="#0B5CAD" CornerRadius="12" Padding="8,3">
                                <TextBlock Text="●  LOCAL NPU" Foreground="White"
                                           FontSize="10" FontWeight="SemiBold" />
                            </Border>
                            <Border Background="White" BorderBrush="#C9DFF2" BorderThickness="1"
                                    CornerRadius="12" Padding="8,3">
                                <TextBlock Text="QNN Execution Provider" Foreground="#0B5CAD"
                                           FontSize="10" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="●" FontSize="24" Foreground="#0B5CAD"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="ON-DEVICE" FontSize="9" FontWeight="Bold"
                                   Foreground="#0B5CAD" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Summary cards row -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Appointments today -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="24" Foreground="#18181B"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.AppointmentCount, Mode=OneWay}"
                                   Style="{StaticResource MetricValueStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Appointments" FontSize="13" Foreground="#71717A"
                                   HorizontalAlignment="Center"
                                   FontFamily="Segoe UI Variable, Segoe UI" />
                    </StackPanel>
                </Border>

                <!-- Calendar gaps -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="&#xEE94;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="24" Foreground="#C77B00"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.GapCount, Mode=OneWay}"
                                   Style="{StaticResource MetricValueStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Calendar Gaps" FontSize="13" Foreground="#71717A"
                                   HorizontalAlignment="Center"
                                   FontFamily="Segoe UI Variable, Segoe UI" />
                    </StackPanel>
                </Border>

                <!-- Prep items -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="24" Foreground="#EF4444"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.PrepItemCount, Mode=OneWay}"
                                   Style="{StaticResource MetricValueStyle}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Prep Required" FontSize="13" Foreground="#71717A"
                                   HorizontalAlignment="Center"
                                   FontFamily="Segoe UI Variable, Segoe UI" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Two-column layout: Schedule + Prep -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Today's Schedule -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Today's Schedule" Style="{StaticResource SectionHeaderStyle}" />

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Appointments, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="2" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:AppointmentItem">
                                    <Border Padding="14,12" CornerRadius="6"
                                            BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{x:Bind Time}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#374151" VerticalAlignment="Center"
                                                       FontFamily="Segoe UI Variable, Segoe UI" />

                                            <TextBlock Grid.Column="1" Text="{x:Bind CustomerName}"
                                                       FontSize="13" Foreground="#111827"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe UI Variable, Segoe UI" />

                                            <Border Grid.Column="2" Background="#F3F4F6"
                                                    CornerRadius="12" Padding="10,4"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Type}" FontSize="11"
                                                           Foreground="#4B5563"
                                                           FontFamily="Segoe UI Variable, Segoe UI" />
                                            </Border>

                                            <Border Grid.Column="3" CornerRadius="12" Padding="10,4"
                                                    VerticalAlignment="Center">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{x:Bind StatusColor}" Opacity="0.12" />
                                                </Border.Background>
                                                <TextBlock Text="{x:Bind Status}" FontSize="11"
                                                           FontFamily="Segoe UI Variable, Segoe UI">
                                                    <TextBlock.Foreground>
                                                        <SolidColorBrush Color="{x:Bind StatusColor}" />
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <!-- Calendar gaps section -->
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <TextBlock Text="&#xEE94;  Calendar Gaps" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#C77B00"
                                       FontFamily="Segoe UI Variable, Segoe UI" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.CalendarGaps, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="6" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Background="#FFFBEB" CornerRadius="6" Padding="12,8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="&#xE7C4;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12" Foreground="#D97706"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind}" FontSize="12"
                                                           Foreground="#A15F00"
                                                           FontFamily="Segoe UI Variable, Segoe UI" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Prep work required -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="24">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Prep Required" Style="{StaticResource SectionHeaderStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" Foreground="#0B5CAD" VerticalAlignment="Center" />
                                <TextBlock Text="Powered by Phi · On-Device AI" FontSize="11"
                                           Foreground="#0B5CAD" FontStyle="Italic"
                                           FontFamily="Segoe UI Variable, Segoe UI" />
                            </StackPanel>
                        </StackPanel>

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.PrepItems, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="12" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:PrepItem">
                                    <Border Background="#F8FAFC" CornerRadius="8"
                                            Padding="14" BorderBrush="#E5E7EB" BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Icon}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="14" Foreground="#18181B"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{x:Bind Title}" FontSize="13"
                                                               FontWeight="SemiBold" Foreground="#111827"
                                                               FontFamily="Segoe UI Variable, Segoe UI"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Border Grid.Column="1" CornerRadius="10" Padding="8,2">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{x:Bind PriorityColor}" Opacity="0.15" />
                                                    </Border.Background>
                                                    <TextBlock Text="{x:Bind Priority}" FontSize="10"
                                                               FontFamily="Segoe UI Variable, Segoe UI">
                                                        <TextBlock.Foreground>
                                                            <SolidColorBrush Color="{x:Bind PriorityColor}" />
                                                        </TextBlock.Foreground>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{x:Bind Description}" FontSize="12"
                                                       Foreground="#71717A" TextWrapping="Wrap"
                                                       FontFamily="Segoe UI Variable, Segoe UI" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
