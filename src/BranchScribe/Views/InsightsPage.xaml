<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BranchScribe.Views.InsightsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:BranchScribe.ViewModels">

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1"
                Padding="32,20,32,16">
            <StackPanel>
                <TextBlock Text="Insights Dashboard" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Productivity and Sustainability Metrics"
                           Style="{StaticResource CaptionStyle}" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Padding="32,24,32,24"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="24" HorizontalAlignment="Stretch">

                <!-- Hero KPI Row -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Time Saved -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E5E7EB"
                            BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#18181B" Height="4" CornerRadius="8,8,0,0" />
                            <StackPanel Grid.Row="1" Padding="20" HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="24" Foreground="#18181B"
                                           HorizontalAlignment="Center" Margin="0,4,0,8" />
                                <TextBlock HorizontalAlignment="Center"
                                           Style="{StaticResource MetricValueStyle}">
                                    <Run Text="{x:Bind ViewModel.TotalTimeSavedDisplay, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="Minutes Saved" HorizontalAlignment="Center"
                                           FontSize="13" Foreground="#71717A"
                                           FontFamily="Segoe UI Variable, Segoe UI" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- CO2 Saved -->
                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E5E7EB"
                            BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#0B5CAD" Height="4" CornerRadius="8,8,0,0" />
                            <StackPanel Grid.Row="1" Padding="20" HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="&#xEC0A;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="24" Foreground="#0B5CAD"
                                           HorizontalAlignment="Center" Margin="0,4,0,8" />
                                <TextBlock HorizontalAlignment="Center"
                                           Style="{StaticResource MetricValueStyle}">
                                    <Run Text="{x:Bind ViewModel.TotalCo2SavedDisplay, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="g CO&#x2082; Saved" HorizontalAlignment="Center"
                                           FontSize="13" Foreground="#71717A"
                                           FontFamily="Segoe UI Variable, Segoe UI" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Customers Helped -->
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E5E7EB"
                            BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#10B981" Height="4" CornerRadius="8,8,0,0" />
                            <StackPanel Grid.Row="1" Padding="20" HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="24" Foreground="#10B981"
                                           HorizontalAlignment="Center" Margin="0,4,0,8" />
                                <TextBlock HorizontalAlignment="Center"
                                           Style="{StaticResource MetricValueStyle}">
                                    <Run Text="{x:Bind ViewModel.TotalCustomersHelped, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="Customers Helped" HorizontalAlignment="Center"
                                           FontSize="13" Foreground="#71717A"
                                           FontFamily="Segoe UI Variable, Segoe UI" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Sentiment -->
                    <Border Grid.Column="3" Background="#FFFFFF" BorderBrush="#E5E7EB"
                            BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#C77B00" Height="4" CornerRadius="8,8,0,0" />
                            <StackPanel Grid.Row="1" Padding="20" HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="&#xED54;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="24" Foreground="#C77B00"
                                           HorizontalAlignment="Center" Margin="0,4,0,8" />
                                <TextBlock HorizontalAlignment="Center"
                                           Style="{StaticResource MetricValueStyle}">
                                    <Run Text="{x:Bind ViewModel.AverageSentimentDisplay, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="Avg Sentiment" HorizontalAlignment="Center"
                                           FontSize="13" Foreground="#71717A"
                                           FontFamily="Segoe UI Variable, Segoe UI" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Detail cards row: CO2 + Planner side by side -->
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- CO2 Detail Card -->
                    <Border Grid.Column="0" Background="#ECFDF5" BorderBrush="#A7F3D0"
                            BorderThickness="1" CornerRadius="8" Padding="24">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="&#xEC0A;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="28" Foreground="#0B5CAD"
                                       VerticalAlignment="Center" />
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="CO&#x2082; per Inference" FontSize="16"
                                           FontWeight="SemiBold" Foreground="#7DE2B8"
                                           FontFamily="Segoe UI Variable, Segoe UI" />
                                <TextBlock Foreground="#047857" FontSize="14"
                                           FontFamily="Segoe UI Variable, Segoe UI">
                                    <Run Text="{x:Bind ViewModel.Co2PerInferenceDisplay, Mode=OneWay}" />
                                    <Run Text="g CO&#x2082; per inference call" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Planner Suggestions Card -->
                    <Border Grid.Column="1" Background="#EFF6FF" BorderBrush="#BFDBFE"
                            BorderThickness="1" CornerRadius="8" Padding="24">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="&#xEA80;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="20" Foreground="#1D4ED8"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Planner Suggestions" FontSize="16"
                                           FontWeight="SemiBold" Foreground="#1E3A5F"
                                           FontFamily="Segoe UI Variable, Segoe UI" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.PlannerSuggestions, Mode=OneWay}"
                                       TextWrapping="Wrap" FontSize="14" Foreground="#1E40AF"
                                       FontFamily="Segoe UI Variable, Segoe UI"
                                       LineHeight="22" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Session History -->
                <Border Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1"
                        CornerRadius="8" Padding="24">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="18" Foreground="#18181B"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Session History" Style="{StaticResource SectionHeaderStyle}" />
                        </StackPanel>

                        <!-- Table header -->
                        <Border Background="#FFFFFF" CornerRadius="6" Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Customer"
                                           FontWeight="SemiBold" FontSize="12"
                                           Foreground="#71717A"
                                           FontFamily="Segoe UI Variable, Segoe UI" />
                                <TextBlock Grid.Column="1" Text="Time Saved"
                                           FontWeight="SemiBold" FontSize="12"
                                           Foreground="#71717A"
                                           FontFamily="Segoe UI Variable, Segoe UI" />
                                <TextBlock Grid.Column="2" Text="Sentiment"
                                           FontWeight="SemiBold" FontSize="12"
                                           Foreground="#71717A"
                                           FontFamily="Segoe UI Variable, Segoe UI" />
                            </Grid>
                        </Border>

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.SessionHistory}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:SessionSummary">
                                    <Border Padding="16,12" Margin="0,1"
                                            CornerRadius="4" Background="#F8FAFC"
                                            BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind CustomerAlias}"
                                                       FontSize="14" Foreground="#18181B"
                                                       FontFamily="Segoe UI Variable, Segoe UI"
                                                       VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Background="#19352F"
                                                    CornerRadius="20" Padding="10,4"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock FontSize="12" Foreground="#7DE2B8"
                                                           FontFamily="Segoe UI Variable, Segoe UI">
                                                    <Run Text="{x:Bind TimeSavedDisplay}" />
                                                    <Run Text="min" />
                                                </TextBlock>
                                            </Border>
                                            <Border Grid.Column="2" Background="#3A2B16"
                                                    CornerRadius="20" Padding="10,4"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock FontSize="12" Foreground="#A15F00"
                                                           FontFamily="Segoe UI Variable, Segoe UI">
                                                    <Run Text="{x:Bind SentimentDisplay}" />
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>



