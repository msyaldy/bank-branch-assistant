<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BranchScribe.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar navigation -->
        <Border Grid.Column="0" Background="#083B66">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand area -->
                <StackPanel Grid.Row="0" Margin="20,14,20,20">
                    <StackPanel Spacing="0">
                        <Image Source="/Assets/logo.png"
                               Width="190" Height="66"
                               Stretch="Uniform"
                               HorizontalAlignment="Left" />
                        <TextBlock Text="BranchScribe" FontSize="22" FontWeight="Bold"
                                   Foreground="White" FontFamily="Segoe UI Variable, Segoe UI"
                                   Margin="0,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Advisor Assistant" FontSize="12"
                               Foreground="#FFFFFF80" FontFamily="Segoe UI Variable, Segoe UI"
                               Margin="0,1,0,0" />
                    <Border Background="#0B5CAD" BorderBrush="#67B5F5" BorderThickness="1" CornerRadius="12"
                            Padding="9,4" Margin="0,12,0,0"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="#FFFFFF"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="LOCAL NPU  ·  QNN"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="White"
                                       FontFamily="Segoe UI Variable, Segoe UI" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Nav items -->
                <StackPanel Grid.Row="1">
                    <Button x:Name="NavHome" Tag="home" Click="NavButton_Click"
                            Style="{StaticResource NavButtonActiveStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="3" Background="#67B5F5" CornerRadius="2"
                                    x:Name="NavHomeAccent" Margin="-4,0,0,0" />
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Home" VerticalAlignment="Center" FontSize="14" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSession" Tag="session" Click="NavButton_Click"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="3" Background="Transparent" CornerRadius="2"
                                    x:Name="NavSessionAccent" Margin="-4,0,0,0" />
                            <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Live Session" VerticalAlignment="Center" FontSize="14" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavReviewPack" Tag="reviewpack" Click="NavButton_Click"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="3" Background="Transparent" CornerRadius="2"
                                    x:Name="NavReviewPackAccent" Margin="-4,0,0,0" />
                            <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Review Pack" VerticalAlignment="Center" FontSize="14" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavInsights" Tag="insights" Click="NavButton_Click"
                            Style="{StaticResource NavButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="3" Background="Transparent" CornerRadius="2"
                                    x:Name="NavInsightsAccent" Margin="-4,0,0,0" />
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Insights" VerticalAlignment="Center" FontSize="14" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Footer -->
                <TextBlock Grid.Row="2" Text="v1.0  ·  Local-First AI"
                           FontSize="11" Foreground="#FFFFFF40"
                           FontFamily="Segoe UI Variable, Segoe UI"
                           Margin="20,0,20,20" />
            </Grid>
        </Border>

        <!-- Content area -->
        <Border Grid.Column="1" Background="#FFFFFF">
            <Frame x:Name="ContentFrame" />
        </Border>
    </Grid>
</Page>

